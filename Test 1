#include <stdio.h> 
#include <unistd.h>
int main(){
printf("Hello world!\n"); //Instruction exécutée par le processus père uniquement
fork(); //Création d'un nouveau processus fils à partir du processus père, cette création se fait par clônage du processus fils
printf("Bonjour!\n"); //Instruction exécutée par les 2 processus (père et fils) gràce au duplicage du processus
}



